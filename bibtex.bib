}

@ARTICLE{Shin2020-tf,
  title         = "Nonparametric iterated-logarithm extensions of the sequential
                   generalized likelihood ratio test",
  author        = "Shin, Jaehyeok and Ramdas, Aaditya and Rinaldo, Alessandro",
  journal       = "arXiv [math.ST]",
  abstract      = "We develop a nonparametric extension of the sequential
