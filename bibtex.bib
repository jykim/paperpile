@ARTICLE{Howard2018-en,
  title         = "Time-uniform, nonparametric, nonasymptotic confidence
                   sequences",
  author        = "Howard, Steven R and Ramdas, Aaditya and McAuliffe, Jon and
                   Sekhon, Jasjeet",
  journal       = "arXiv [math.ST]",
  abstract      = "A confidence sequence is a sequence of confidence intervals
                   that is uniformly valid over an unbounded time horizon. Our
                   work develops confidence sequences whose widths go to zero,
                   with nonasymptotic coverage guarantees under nonparametric
                   conditions. We draw connections between the Cram\'er-Chernoff
                   method for exponential concentration, the law of the iterated
