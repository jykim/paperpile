@ARTICLE{Veale2018-si,
  title         = "Fairness and Accountability Design Needs for Algorithmic
                   Support in High-Stakes Public Sector Decision-Making",
  author        = "Veale, Michael and Van Kleek, Max and Binns, Reuben",
  journal       = "arXiv [cs.CY]",
  abstract      = "Calls for heightened consideration of fairness and
                   accountability in algorithmically-informed public
                   decisions---like taxation, justice, and child
                   protection---are now commonplace. How might designers support
                   such human values? We interviewed 27 public sector machine
                   learning practitioners across 5 OECD countries regarding
