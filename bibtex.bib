@INPROCEEDINGS{Turnbull2019-kq,
  title     = "Learning Intent to Book Metrics for Airbnb Search",
  author    = "Turnbull, Bradley C",
  booktitle = "The World Wide Web Conference",
  publisher = "Association for Computing Machinery",
  address   = "New York, NY, USA",
  pages     = "3265--3271",
  abstract  = "Airbnb is a two-sided rental marketplace offering a variety of
               unique and more traditional accommodation options. Similar to
               other online marketplaces we invest in optimizing the content
               surfaced on the search UI and ranking relevance to improve the
               guest online search experience. The unique Airbnb inventory,
