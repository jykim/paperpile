  year      =  2021
}

@ARTICLE{Perez2022-ws,
  title         = "Red Teaming Language Models with Language Models",
  author        = "Perez, Ethan and Huang, Saffron and Song, Francis and Cai,
                   Trevor and Ring, Roman and Aslanides, John and Glaese, Amelia
