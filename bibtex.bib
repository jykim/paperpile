@ARTICLE{Iannelli2026-ag,
  title         = "From prompt to purchase: How {AI} brand recommendations move
                   consumers on the open web",
  author        = "Iannelli, Michael and Ai, Alan",
  journal       = "arXiv [cs.CY]",
  abstract      = "When a conversational assistant recommends a brand to a user
                   with no recent observed engagement, that user's same-name
                   Google search rises +4.3 percentage points (pp) [3.1, 5.5],
                   visits to the brand's own site +2.4 pp [1.4, 3.5], and
