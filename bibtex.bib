}

@MISC{Quistorff2021-rz,
  title        = "Sparse synthetic controls: Unit-level counterfactuals from
                  high-dimensional data",
  author       = "Quistorff, Brian and Thorpe, Jason",
  abstract     = "Synthetic Control (SC) methods (Abadie et al., 2010) are a
                  common empirical strategy for estimating treatment effects in
                  the presence of potentially unobserved endogenous factors.
                  They construct unit-level matches by finding similar units
                  over important pre-treatment variables. Existing work has
                  provided little guidance on both how to select the
                  pre-treatment variables for the model and on how to reduce
                  over-fitting in big data settings. We propose a modified
                  ``Spars-eSC'' estimator that regularizes both the unit and
                  variable weights (allowing automated model selection) and
                  maximizes out-of-sample fit of the counterfactuals for the
                  control units in the posttreatment period. Conditions are
                  provided under which the estimator is consistent. We connect
                  the ideas of ``honest residuals'' and cross-fitting
                  (Chernozhukov et al., 2018) to randomization inference and
                  show when it is required. We apply our method both to the
                  small-data setting of Abadie et al. (2010), where we show
                  gains from our method, and to a big-data setting at Microsoft
                  where we analyze the introduction of a service and accounting
                  for user-level selection is crucial.",
  year         =  2021,
  howpublished = "\url{https://s3.eu-west-2.amazonaws.com/images.scholarsite.io/c6469da44742256d866e576c4670103d.pdf}",
