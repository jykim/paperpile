@INCOLLECTION{Shani2011-qh,
  title     = "Evaluating Recommendation Systems",
  author    = "Shani, Guy and Gunawardana, Asela",
  editor    = "Ricci, Francesco and Rokach, Lior and Shapira, Bracha and Kantor,
