@INCOLLECTION{Urbano2015-kr,
  title     = "How do gain and discount functions affect the correlation between
               {DCG} and user satisfaction?",
  author    = "Urbano, Julián and Marrero, Mónica",
  booktitle = "Lecture Notes in Computer Science",
  publisher = "Springer International Publishing",
  address   = "Cham",
  pages     = "197--202",
  abstract  = "We present an empirical analysis of the effect that the gain and
               discount functions have in the correlation between DCG and user
