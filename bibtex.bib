@ARTICLE{Belcak2025-zi,
  title         = "Small Language Models are the Future of Agentic {AI}",
  author        = "Belcak, Peter and Heinrich, Greg and Diao, Shizhe and Fu,
                   Yonggan and Dong, Xin and Muralidharan, Saurav and Lin,
