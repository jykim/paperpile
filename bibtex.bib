@ARTICLE{Romero-Alvarado2026-pk,
  title         = "Capabilities ain't all you need: Measuring propensities in
                   {AI}",
  author        = "Romero-Alvarado, Daniel and Martínez-Plumed, Fernando and
                   Pacchiardi, Lorenzo and Save, Hugo and Pawar, Siddhesh Milind
