@ARTICLE{Pu2023-yz,
  title         = "Summarization is (Almost) Dead",
  author        = "Pu, Xiao and Gao, Mingqi and Wan, Xiaojun",
  journal       = "arXiv [cs.CL]",
  abstract      = "How well can large language models (LLMs) generate summaries?
                   We develop new datasets and conduct human evaluation
                   experiments to evaluate the zero-shot generation capability
                   of LLMs across five distinct summarization tasks. Our
                   findings indicate a clear preference among human evaluators
                   for LLM-generated summaries over human-written summaries and
