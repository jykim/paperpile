@INPROCEEDINGS{Amatriain2009-zs,
  title     = "{I} Like It... {I} Like It Not: Evaluating User Ratings Noise in
               Recommender Systems",
  author    = "Amatriain, Xavier and Pujol, Josep M and Oliver, Nuria",
  booktitle = "User Modeling, Adaptation, and Personalization",
  publisher = "Springer Berlin Heidelberg",
  pages     = "247--258",
  abstract  = "Recent growing interest in predicting and influencing consumer
               behavior has generated a parallel increase in research efforts on
               Recommender Systems. Many of the state-of-the-art Recommender
