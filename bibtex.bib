@ARTICLE{Chen2022-gi,
  title         = "Measuring ``Why'' in Recommender Systems: a Comprehensive
                   Survey on the Evaluation of Explainable Recommendation",
  author        = "Chen, Xu and Zhang, Yongfeng and Wen, Ji-Rong",
  journal       = "arXiv [cs.IR]",
  abstract      = "Explainable recommendation has shown its great advantages for
                   improving recommendation persuasiveness, user satisfaction,
                   system transparency, among others. A fundamental problem of
                   explainable recommendation is how to evaluate the
                   explanations. In the past few years, various evaluation
                   strategies have been proposed. However, they are scattered in
                   different papers, and there lacks a systematic and detailed
                   comparison between them. To bridge this gap, in this paper,
