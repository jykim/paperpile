@ARTICLE{Arabzadeh2024-qr,
  title         = "A comparison of methods for evaluating generative {IR}",
  author        = "Arabzadeh, Negar and Clarke, Charles L A",
  journal       = "arXiv [cs.IR]",
  institution   = "Github",
  abstract      = "Information retrieval systems increasingly incorporate
                   generative components. For example, in a retrieval augmented
                   generation (RAG) system, a retrieval component might provide
                   a source of ground truth, while a generative component
