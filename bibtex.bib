@ARTICLE{Yang2016-sj,
  title         = "Measuring Fairness in Ranked Outputs",
  author        = "Yang, Ke and Stoyanovich, Julia",
  journal       = "arXiv [cs.DB]",
  abstract      = "Ranking and scoring are ubiquitous. We consider the setting
                   in which an institution, called a ranker, evaluates a set of
